<% layout('layouts/main') %>

<!-- Include Leaflet CSS & JS for Map Picker -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="flex items-center justify-center min-h-[85vh] py-8">
  <div class="bg-white rounded-2xl shadow-xl p-8 w-full max-w-lg">
    <div class="text-center mb-6">
      <i class="fas fa-user-plus text-blue-600 text-4xl mb-2"></i>
      <h1 class="text-2xl font-bold text-dark">Create an Account</h1>
      <p class="text-gray-500 text-sm">Join KDY's Arts & Crafts community</p>
    </div>

    <form action="/auth/register" method="POST" class="space-y-4">
      <!-- First & Last Name -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
          <input type="text" name="firstName" required placeholder="Juan"
            class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none transition text-sm" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
          <input type="text" name="lastName" required placeholder="Dela Cruz"
            class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none transition text-sm" />
        </div>
      </div>

      <!-- Email -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
        <div class="relative">
          <i class="fas fa-envelope absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
          <input type="email" name="email" required placeholder="you@example.com"
            class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none transition text-sm" />
        </div>
      </div>

      <!-- Phone Number -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
        <div class="relative">
          <i class="fas fa-phone absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
          <input type="tel" name="phoneNumber" required placeholder="09123456789"
            class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none transition text-sm" />
        </div>
      </div>

      <!-- ================= SHOPEE-STYLE MAP ADDRESS PICKER ================= -->
      <div class="space-y-2 bg-gray-50 p-4 rounded-xl border border-gray-200">
        <label class="block text-sm font-semibold text-dark flex items-center justify-between">
          <span><i class="fas fa-map-marker-alt text-blue-600 mr-1.5"></i> Delivery Address</span>
          <span class="text-xs text-gray-500 font-normal">(Drag pin or use GPS)</span>
        </label>

        <!-- Detect Location Button (Blue Theme) -->
        <button type="button" onclick="detectLocation()" 
          class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-3 rounded-lg flex items-center justify-center gap-2 transition text-xs shadow-sm">
          <i class="fas fa-crosshairs"></i> Use Current Location (Detect GPS)
        </button>

        <!-- Map Container -->
        <div id="addressMap" class="w-full h-52 rounded-lg border border-gray-300 z-10 shadow-inner"></div>

        <!-- Selected Address Textarea -->
        <textarea id="fullAddress" name="address" required rows="2" 
          placeholder="Drag pin on map or type exact address (House/Unit No., Street, Brgy., City)..." 
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none transition text-xs bg-white font-medium"></textarea>

        <!-- Hidden coordinates fields -->
        <input type="hidden" id="latitude" name="latitude">
        <input type="hidden" id="longitude" name="longitude">
      </div>

      <!-- Password & Confirm Password -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
          <input type="password" name="password" required placeholder="••••••••" minlength="8"
            class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none transition text-sm" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Confirm Password</label>
          <input type="password" name="confirmPassword" required placeholder="••••••••" minlength="8"
            class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none transition text-sm" />
        </div>
      </div>

      <!-- Submit Button (Blue Theme) -->
      <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-lg transition shadow">
        <i class="fas fa-user-check mr-2"></i> Register Account
      </button>
    </form>

    <p class="text-center text-sm text-gray-500 mt-6">
      Already have an account? <a href="/auth/login" class="text-blue-600 hover:underline font-semibold">Login here</a>
    </p>
  </div>
</div>

<!-- LEAFLET MAP LOGIC SCRIPT -->
<script>
  let map, marker;

  // Default coordinates: Central Luzon / Nueva Ecija area
  const defaultLat = 15.4828;
  const defaultLng = 120.9702;

  document.addEventListener('DOMContentLoaded', function() {
    // Initialize Map
    map = L.map('addressMap').setView([defaultLat, defaultLng], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© OpenStreetMap'
    }).addTo(map);

    // Draggable Pin
    marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(map);

    // Update address on drag end
    marker.on('dragend', function() {
      const pos = marker.getLatLng();
      updateAddressFromCoords(pos.lat, pos.lng);
    });

    // Update address on map click
    map.on('click', function(e) {
      marker.setLatLng(e.latlng);
      updateAddressFromCoords(e.latlng.lat, e.latlng.lng);
    });
  });

  // Reverse Geocoding (Convert Lat/Lng to readable Address)
  async function updateAddressFromCoords(lat, lng) {
    document.getElementById('latitude').value = lat;
    document.getElementById('longitude').value = lng;

    try {
      const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`);
      const data = await response.json();
      if (data && data.display_name) {
        document.getElementById('fullAddress').value = data.display_name;
      }
    } catch (err) {
      console.error("Geocoding failed:", err);
    }
  }

  // Detect GPS Location with IP Fallback (No infinite loading)
  async function detectLocation() {
    const btn = document.querySelector("button[onclick='detectLocation()']");
    const originalText = btn ? btn.innerHTML : '<i class="fas fa-crosshairs"></i> Use Current Location (Detect GPS)';
    
    if (btn) {
      btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Detecting Location...';
      btn.disabled = true;
    }

    let gpsSuccess = false;

    if (navigator.geolocation) {
      await new Promise((resolve) => {
        const timer = setTimeout(() => {
          resolve(false);
        }, 4000); // 4 seconds limit para sa GPS

        navigator.geolocation.getCurrentPosition(
          (position) => {
            clearTimeout(timer);
            const lat = position.coords.latitude;
            const lng = position.coords.longitude;
            map.setView([lat, lng], 16);
            marker.setLatLng([lat, lng]);
            updateAddressFromCoords(lat, lng);
            gpsSuccess = true;
            resolve(true);
          },
          (error) => {
            clearTimeout(timer);
            resolve(false);
          },
          { enableHighAccuracy: false, timeout: 3500, maximumAge: Infinity }
        );
      });
    }

    // Kung nag-fail o nag-timeout ang GPS (hal. nasa PC/Laptop), gamitin ang IP Geolocation
    if (!gpsSuccess) {
      try {
        const response = await fetch('https://ipapi.co/json/');
        const data = await response.json();
        
        if (data && data.latitude && data.longitude) {
          const lat = data.latitude;
          const lng = data.longitude;
          
          map.setView([lat, lng], 14);
          marker.setLatLng([lat, lng]);
          updateAddressFromCoords(lat, lng);
        } else {
          alert("Hindi ma-detect ang eksaktong lokasyon. Paki-drag na lang po ang pin sa mapa manu-mano.");
        }
      } catch (err) {
        console.error("IP Geolocation failed:", err);
        alert("Paki-drag na lang po ang pin sa mapa para sa iyong delivery address.");
      }
    }

    if (btn) {
      btn.innerHTML = originalText;
      btn.disabled = false;
    }
  }